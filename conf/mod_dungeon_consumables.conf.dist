[worldserver]

########################################
# mod-dungeon-consumables
#
# Real players (not playerbots) get Delver's Draughts when they enter a dungeon. Each
# restores 50% of maximum health and mana over 10 seconds, so it works the same at every level.
# Whatever is left disappears when they leave. Coming back to the same run (after a corpse run
# or a trip out to repair) gives back what they left with.
#
# The potion is its own item, so potions a player already owns are never touched. It shares the
# normal potion cooldown.
########################################

#
#    DungeonConsumables.Enable
#        Description: Hand out Delver's Draughts. Turning this off still takes away any that
#                     players are holding the next time they change maps.
#        Default:     1
#

DungeonConsumables.Enable = 1

#
#    DungeonConsumables.Potions
#        Description: How many potions a player gets per run. More than 20 takes a second bag
#                     slot.
#        Default:     5
#

DungeonConsumables.Potions = 5

#
#    DungeonConsumables.IncludeRaids
#        Description: Also hand them out in raids.
#        Default:     0
#

DungeonConsumables.IncludeRaids = 0

#
#    DungeonConsumables.Announce
#        Description: Tell players in chat that the potions disappear when they leave.
#        Default:     1
#

DungeonConsumables.Announce = 1
